<%# app/views/posts/_post.html.erb %>

<div style="display: flex; gap: 12px; padding: 15px; border-bottom: 1px solid #eee; background: white; border-radius: 8px; margin-bottom: 10px; font-family: sans-serif;">
  
  <%# 1. КОЛОНКА С АВАТАРКОЙ %>
  <div style="flex-shrink: 0;">
    <%= link_to user_path(post.user) do %>
      <% if post.user.avatar.attached? %>
        <%= image_tag post.user.avatar, style: "width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 1px solid #eee;" %>
      <% else %>
        <div style="width: 40px; height: 40px; border-radius: 50%; background: #e1e8ed; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: bold; color: #777; border: 1px solid #eee;">
          <%= post.user.username.first.upcase %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# 2. КОЛОНКА С ТЕКСТОМ ПОСТА %>
  <div style="flex-grow: 1;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
      <div style="display: flex; align-items: center; gap: 5px;">
        <%= link_to user_path(post.user), style: "text-decoration: none; color: black; font-weight: bold;" do %>
          @<%= post.user.username %>
        <% end %>
        <span style="color: #666; font-size: 0.9rem;">
          · <%= time_ago_in_words(post.created_at) %> назад
        </span>
      </div>

      <%# Кнопки управления для автора %>
      <% if user_signed_in? && post.user == current_user %>
        <div style="display: flex; gap: 10px; font-size: 0.85rem;">
          <%= link_to "Редактировать", edit_post_path(post), style: "color: #1da1f2; text-decoration: none;" %>
          <%= link_to "Удалить", post_path(post), data: { turbo_method: :delete, turbo_confirm: "Вы уверены?" }, style: "color: #e57373; text-decoration: none;" %>
        </div>
      <% end %>
    </div>

    <%# Кликабельный текст поста, ведущий на отдельную страницу %>
    <%= link_to post_path(post), style: "text-decoration: none; color: #333;" do %>
      <div style="line-height: 1.4; word-break: break-word; margin-bottom: 10px;">
        <%= post.content %>
      </div>
    <% end %>

<%# Блок кнопок: Лайки и Комментарии %>
    <div style="display: flex; gap: 20px; margin-top: 10px;">
      
      <%# 1. Кнопка Лайка (теперь слева) %>
      <% if user_signed_in? %>
        <% liked = post.likes.any? { |l| l.user_id == current_user.id } %>
        
        <% if liked %>
          <%= link_to post_like_path(post, id: 0), data: { turbo_method: :delete }, style: "text-decoration: none; color: #e0245e; font-size: 0.9rem; display: flex; align-items: center; gap: 4px; font-weight: bold;" do %>
            ❤️ <%= post.likes.count %>
          <% end %>
        <% else %>
          <%= link_to post_likes_path(post), data: { turbo_method: :post }, style: "text-decoration: none; color: #657786; font-size: 0.9rem; display: flex; align-items: center; gap: 4px;" do %>
            🤍 <%= post.likes.count %>
          <% end %>
        <% end %>
      <% else %>
        <span style="color: #657786; font-size: 0.9rem; display: flex; align-items: center; gap: 4px;">
          🤍 <%= post.likes.count %>
        </span>
      <% end %>

      <%# 2. Ссылка на комментарии (теперь справа) %>
      <%= link_to post_path(post), style: "text-decoration: none; color: #657786; font-size: 0.9rem; display: flex; align-items: center; gap: 4px;" do %>
        💬 <%= post.comments.count %>
      <% end %>
    </div>
  </div>

</div>