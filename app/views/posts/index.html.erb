<%# app/views/posts/index.html.erb %>

<div style="max-width: 700px; margin: 30px auto; padding: 0 15px; font-family: sans-serif;">

  <% if user_signed_in? %>
    <div style="border: 1px solid #ccc; padding: 20px; margin-bottom: 25px; border-radius: 10px; background: #f9f9f9;">
      <% if @post.errors.any? %>
        <div style="border: 1px solid #e57373; background: #fdecea; padding: 12px; margin-bottom: 15px; border-radius: 8px;">
          <h2 style="margin-top: 0;">Ошибки:</h2>
          <ul style="margin-bottom: 0;">
            <% @post.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @post, url: posts_path do |f| %>
        <div style="margin-bottom: 15px;">
          <%= f.text_area :content,
                          placeholder: "Что происходит?",
                          maxlength: 280,
                          rows: 4,
                          style: "width: 100%; padding: 10px; box-sizing: border-box;" %>
        </div>

        <div style="text-align: right;">
          <%= f.submit "Опубликовать", style: "padding: 8px 16px;" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div style="border: 1px solid #ccc; padding: 20px; margin-bottom: 25px; border-radius: 10px; text-align: center; background: #f9f9f9;">
      <h2>Добро пожаловать</h2>
      <p>Войдите или зарегистрируйтесь, чтобы публиковать посты.</p>

      <div style="margin-top: 15px;">
        <%= link_to "Войти", new_user_session_path, style: "margin-right: 10px;" %>
        <%= link_to "Регистрация", new_user_registration_path %>
      </div>
    </div>
  <% end %>

  <%# --- ЛЕНТА ПОСТОВ С ПАГИНАЦИЕЙ --- %>
  <div id="feed">
    <% if @posts.present? %>
      <%= render @posts %>

      <%# --- БЛОК КНОПОК ПАГИНАЦИИ --- %>
      <div style="margin-top: 30px; margin-bottom: 30px; display: flex; justify-content: center;">
        <div class="pagination-container" style="display: flex; gap: 8px; align-items: center;">
          <%= paginate @posts, window: 2 %>
        </div>
      </div>
      
      <%# Кастомные инлайн-стили для элементов kaminari %>
      <style>
        .pagination-container a, .pagination-container .current {
          padding: 8px 14px;
          border: 1px solid #ccc;
          border-radius: 20px;
          text-decoration: none;
          color: #1da1f2;
          font-weight: bold;
          font-size: 0.9rem;
        }
        .pagination-container .current {
          background: #1da1f2;
          color: white;
          border-color: #1da1f2;
        }
        .pagination-container .disabled, .pagination-container .gap {
          padding: 8px 14px;
          color: #999;
          font-size: 0.9rem;
        }
      </style>
      <%# ----------------------------- %>

    <% else %>
      <div style="text-align: center; padding: 40px 0; color: #666;">
        <p style="font-size: 22px; margin-bottom: 10px;">Пока нет постов</p>
      </div>
    <% end %>
  </div>
</div>