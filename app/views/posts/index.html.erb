<%# app/views/posts/index.html.erb %>

<div class="max-w-5xl mx-auto px-4 py-6 flex gap-6 font-sans">
  
  <%# --- ЛЕВАЯ КОЛОНКА: ОСНОВНАЯ ЛЕНТА ПОСТОВ --- %>
  <div class="flex-1 min-w-0 space-y-4">
    
    <%# Заголовок ленты %>
    <div class="flex items-center gap-2 mb-2">
      <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
      </svg>
      <h2 class="text-xl font-bold text-slate-900">
        <%= params[:feed_scope] == 'following' ? 'Моя лента подписок' : 'Ваша лента' %>
      </h2>
    </div>

    <% if user_signed_in? %>
      <%# --- БЛОК ОШИБОК ВАЛИДАЦИИ --- %>
      <% if @post.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-2xl p-4 text-sm text-red-600">
          <span class="font-bold">Возникли ошибки:</span>
          <ul class="list-disc pl-5 mt-1">
            <% @post.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# --- ФОРМА СОЗДАНИЯ ПОСТА (Аналог <CreatePost />) --- %>
      <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
        <%= form_with model: @post, url: posts_path, local: true do |f| %>
          <div class="mb-3">
            <%= f.text_area :content,
                            placeholder: "Что нового?",
                            maxlength: 280,
                            rows: 4,
                            class: "w-full p-3 border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none text-sm transition-colors" %>
          </div>
          <div class="flex justify-between items-center">
            <span class="text-xs text-slate-400">Максимум 280 символов</span>
            <%= f.submit "Опубликовать", class: "px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-semibold hover:bg-blue-700 transition-colors cursor-pointer shadow-sm" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Приветствие для гостей %>
      <div class="bg-white border border-slate-200 rounded-2xl p-6 text-center shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Добро пожаловать в Ribbon</h3>
        <p class="text-slate-500 text-sm mb-4">Войдите или зарегистрируйтесь, чтобы делиться мыслями и подписываться на других студентов.</p>
        <div class="flex justify-center gap-3">
          <%= link_to "Войти", new_user_session_path, class: "px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-semibold hover:bg-blue-700 transition-colors" %>
          <%= link_to "Регистрация", new_user_registration_path, class: "px-4 py-2 border border-slate-200 text-slate-600 rounded-full text-sm font-semibold hover:bg-slate-50 transition-colors" %>
        </div>
      </div>
    <% end %>

    <%# --- РЕНДЕР ЛЕНТЫ ПОСТОВ --- %>
    <div id="feed" class="space-y-3">
      <% if @posts.present? %>
        <%= render @posts %>

        <%# Пагинация Kaminari, стилизованная под макет %>
        <div class="mt-6 flex justify-center py-4">
          <div class="pagination-tailwind flex gap-1 items-center">
            <%= paginate @posts, window: 2 %>
          </div>
        </div>
      <% else %>
        <%# Состояние пустой ленты (Копия заглушки из Figma) %>
        <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center shadow-sm">
          <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Ваша лента пуста</h3>
          <p class="text-slate-500 text-sm max-w-xs mx-auto mb-4">
            Подпишитесь на людей, чтобы видеть их посты здесь, или откройте общую ленту.
          </p>
          <%= link_to "Найти людей для подписки", root_path(feed_scope: 'global'), class: "inline-block px-4 py-2 bg-blue-600 text-white rounded-full text-sm font-semibold hover:bg-blue-700 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# --- ПРАВАЯ КОЛОНКА (САЙДБАР): WHO TO FOLLOW & FILTERS --- %>
  <aside class="w-72 flex-shrink-0 hidden xl:block space-y-5">
    
    <%# Блок инлайн-поиска пользователей %>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <h4 class="text-sm font-bold text-slate-900">Поиск участников</h4>
      </div>
      <%= form_with(url: root_path, method: :get, local: true, class: "space-y-2") do |f| %>
        <%= hidden_field_tag :feed_scope, params[:feed_scope] %>
        <%= hidden_field_tag :sort, params[:sort] %>
        <%= text_field_tag :query, params[:query], placeholder: "Поиск по @username...", class: "w-full px-3 py-2 text-xs border border-slate-200 rounded-xl text-slate-900 focus:outline-none focus:border-blue-500" %>
        <div class="flex gap-2">
          <%= f.submit "Найти", class: "flex-1 text-center py-1.5 bg-blue-600 text-white rounded-xl text-xs font-semibold hover:bg-blue-700 transition-colors cursor-pointer" %>
          <% if params[:query].present? %>
            <%= link_to "Сбросить", root_path(feed_scope: params[:feed_scope], sort: params[:sort]), class: "px-2 py-1.5 border border-slate-200 text-slate-500 rounded-xl text-xs hover:bg-slate-50 text-center" %>
          <% end %>
        </div>
      <% end %>

      <%# Результаты быстрого поиска пользователей %>
      <% if @search_results.present? %>
        <div class="mt-4 pt-3 border-t border-slate-100 space-y-2">
          <% @search_results.each do |user| %>
            <div class="flex items-center justify-between gap-2 text-xs">
              <%= link_to user_path(user), class: "flex items-center gap-2 font-semibold text-slate-700 hover:text-blue-600" do %>
                <div class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center font-bold text-[10px] text-slate-600">
                  <%= user.username.first.upcase %>
                </div>
                <span class="truncate max-w-[100px]">@<%= user.username %></span>
              <% end %>
              <% if user_signed_in? && user != current_user %>
                <%= link_to current_user.following?(user) ? "✓" : "+ Подписаться", follow_user_path(user), data: { turbo_method: :post }, class: "text-[11px] text-blue-600 font-bold hover:underline" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Блок фильтров и переключения ленты (Объединен с логикой макета) %>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        <h4 class="text-sm font-bold text-slate-900">Раздел ленты</h4>
      </div>
      <div class="space-y-1.5">
        <%= link_to root_path(sort: params[:sort]), class: "flex items-center justify-between w-full px-3 py-2 rounded-xl text-xs font-semibold transition-colors #{params[:feed_scope] != 'following' ? 'bg-blue-50 text-blue-600' : 'text-slate-600 hover:bg-slate-50'}" do %>
          <span>Общая лента</span>
          <span class="text-[10px] bg-slate-200 text-slate-600 px-1.5 py-0.5 rounded-md font-mono">ВСЕ</span>
        <% end %>
        
        <% if user_signed_in? %>
          <%= link_to root_path(feed_scope: 'following', sort: params[:sort]), class: "flex items-center justify-between w-full px-3 py-2 rounded-xl text-xs font-semibold transition-colors #{params[:feed_scope] == 'following' ? 'bg-blue-50 text-blue-600' : 'text-slate-600 hover:bg-slate-50'}" do %>
            <span>Мои подписки</span>
            <span class="text-[10px] bg-blue-100 text-blue-600 px-1.5 py-0.5 rounded-md font-mono">ПОДП</span>
          <% end %>
        <% end %>
      </div>

      <%# Сортировка по времени %>
      <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs">
        <span class="text-slate-400">Сортировка:</span>
        <div class="flex gap-2">
          <%= link_to "Новые", root_path(feed_scope: params[:feed_scope], sort: 'new'), class: "font-semibold #{params[:sort] != 'old' ? 'text-blue-600 underline' : 'text-slate-500 hover:text-slate-900'}" %>
          <span class="text-slate-200">|</span>
          <%= link_to "Старые", root_path(feed_scope: params[:feed_scope], sort: 'old'), class: "font-semibold #{params[:sort] == 'old' ? 'text-blue-600 underline' : 'text-slate-500 hover:text-slate-900'}" %>
        </div>
      </div>
    </div>

    <%# Копирайт-строка как в макете %>
    <p class="text-xs text-slate-400 px-1">
      © 2026 Ribbon · Студенческий проект · Создано на Ruby on Rails
    </p>
  </aside>
</div>

<%# Кастомный CSS для плавного внедрения пагинации Kaminari в архитектуру Tailwind %>
<style>
  .pagination-tailwind a, .pagination-tailwind .current, .pagination-tailwind .gap, .pagination-tailwind .disabled {
    padding: 6px 12px !important;
    font-size: 0.75rem !important;
    font-weight: 600 !important;
    border-radius: 9999px !important;
    border: 1px solid #e2e8f0 !important;
    background: #ffffff !important;
    color: #475569 !important;
    transition: all 0.2s;
  }
  .pagination-tailwind a:hover {
    background: #f8fafc !important;
    color: #1d4ed8 !important;
    border-color: #cbd5e1 !important;
  }
  .pagination-tailwind .current {
    background: #2563eb !important;
    color: #ffffff !important;
    border-color: #2563eb !important;
  }
</style>