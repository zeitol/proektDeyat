<%# app/views/posts/show.html.erb %>

<div style="max-width: 700px; margin: 30px auto; padding: 0 15px; font-family: sans-serif;">
  
  <%# Ссылка "Назад в ленту" %>
  <%= link_to "← Назад в ленту", root_path, style: "text-decoration: none; color: #1da1f2; font-weight: bold; display: inline-block; margin-bottom: 20px;" %>

  <%# Крупная карточка самого поста %>
  <div style="border: 1px solid #ccc; padding: 20px; border-radius: 10px; background: white; margin-bottom: 25px;">
    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
      <% if @post.user.avatar.attached? %>
        <%= image_tag @post.user.avatar, style: "width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" %>
      <% else %>
        <div style="width: 50px; height: 50px; border-radius: 50%; background: #e1e8ed; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: bold; color: #777;">
          <%= @post.user.username.first.upcase %>
        </div>
      <% end %>
      
      <div>
        <%= link_to user_path(@post.user), style: "text-decoration: none; color: black; font-weight: bold; font-size: 1.1rem;" do %>
          @<%= @post.user.username %>
        <% end %>
        <div style="color: #666; font-size: 0.85rem;"><%= @post.created_at.strftime("%H:%M · %d %b %Y") %></div>
      </div>
    </div>

    <div style="font-size: 1.3rem; line-height: 1.5; color: #111; word-break: break-word; margin-bottom: 15px;">
      <%= @post.content %>
    </div>

    <%# --- ПАНЕЛЬ ДЕЙСТВИЙ (ЛАЙКИ СЛЕВА, УПРАВЛЕНИЕ СПРАВА) --- %>
    <div style="border-top: 1px solid #eee; padding-top: 10px; display: flex; justify-content: space-between; align-items: center;">
      
      <%# Лайки слева %>
      <div>
        <% if user_signed_in? %>
          <% liked = @post.likes.any? { |l| l.user_id == current_user.id } %>
          <% if liked %>
            <%= link_to post_like_path(@post, id: 0), data: { turbo_method: :delete }, style: "text-decoration: none; color: #e0245e; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 6px; font-weight: bold;" do %>
              ❤️ <%= @post.likes.count %>
            <% end %>
          <% else %>
            <%= link_to post_likes_path(@post), data: { turbo_method: :post }, style: "text-decoration: none; color: #657786; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 6px;" do %>
              🤍 <%= @post.likes.count %>
            <% end %>
          <% end %>
        <% else %>
          <span style="color: #657786; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 6px;">
            🤍 <%= @post.likes.count %>
          </span>
        <% end %>
      </div>

      <%# Кнопки управления справа (только для автора поста) %>
      <% if user_signed_in? && @post.user == current_user %>
        <div style="display: flex; gap: 15px; font-size: 0.9rem;">
          <%= link_to "Редактировать", edit_post_path(@post), style: "color: #1da1f2; text-decoration: none;" %>
          <%= link_to "Удалить", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "Вы уверены?" }, style: "color: #e57373; text-decoration: none;" %>
        </div>
      <% end %>

    </div>
  </div>

  <%# БЛОК КОММЕНТАРИЕВ %>
  <div style="border: 1px solid #eee; padding: 20px; border-radius: 10px; background: #f9f9f9;">
    <h3 style="margin: 0 0 20px 0; font-size: 1.1rem; color: #333;">Комментарии (<%= @post.comments.count %>)</h3>

    <%# Форма создания комментария %>
    <% if user_signed_in? %>
      <%= form_with(model: [@post, @post.comments.build], local: true, style: "display: flex; gap: 10px; margin-bottom: 25px;") do |f| %>
        <%= f.text_field :body, placeholder: "Написать ответ...", required: true, 
                         style: "flex-grow: 1; padding: 10px 15px; border: 1px solid #ccc; border-radius: 20px; font-size: 0.95rem; outline: none;" %>
        <%= f.submit "Ответить", style: "background: #1da1f2; color: white; border: none; padding: 10px 20px; border-radius: 20px; font-size: 0.95rem; cursor: pointer; font-weight: bold;" %>
      <% end %>
    <% else %>
      <p style="color: #666; font-size: 0.9rem; margin-bottom: 20px;">Войдите, чтобы оставить ответ.</p>
    <% end %>

    <%# Дерево существующих комментариев %>
    <div style="display: flex; flex-direction: column; gap: 15px;">
      <% @post.comments.each do |comment| %>
        <% if comment.persisted? %>
          <div style="display: flex; gap: 10px; background: white; padding: 12px; border-radius: 8px; border: 1px solid #e6ecf0;">
            <div style="flex-shrink: 0;">
              <% if comment.user.avatar.attached? %>
                <%= image_tag comment.user.avatar, style: "width: 30px; height: 30px; border-radius: 50%; object-fit: cover;" %>
              <% else %>
                <div style="width: 30px; height: 30px; border-radius: 50%; background: #e1e8ed; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; color: #777;">
                  <%= comment.user.username.first.upcase %>
                </div>
              <% end %>
            </div>
            
            <div style="flex-grow: 1;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px;">
                <span style="font-weight: bold; font-size: 0.9rem;">@<%= comment.user.username %></span>
                <% if user_signed_in? && (comment.user == current_user || @post.user == current_user) %>
                  <%= link_to "×", post_comment_path(@post, comment), 
                              data: { turbo_method: :delete, turbo_confirm: "Удалить этот комментарий?" }, 
                              style: "color: #e57373; text-decoration: none; font-weight: bold; font-size: 1.1rem; line-height: 1;" %>
                <% end %>
              </div>
              <div style="font-size: 0.95rem; color: #333; word-break: break-word;">
                <%= comment.body %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

</div>