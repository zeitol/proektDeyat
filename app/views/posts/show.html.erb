<%# Убираем все style="..." и используем классы Tailwind %>
<div class="space-y-6">
  
  <%# Ссылка "Назад" %>
  <%= link_to "← Назад в ленту", root_path, class: "text-blue-500 font-bold hover:underline" %>

  <%# Карточка поста %>
  <article class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
    <div class="flex items-center gap-3 mb-4">
      <% if @post.user.avatar.attached? %>
        <%= image_tag @post.user.avatar, class: "w-12 h-12 rounded-full object-cover" %>
      <% else %>
        <div class="w-12 h-12 rounded-full bg-slate-200 flex items-center justify-center font-bold text-slate-500">
          <%= @post.user.username.first.upcase %>
        </div>
      <% end %>
      
      <div>
        <%= link_to "@#{@post.user.username}", user_path(@post.user), class: "font-bold text-slate-900 hover:underline" %>
        <div class="text-xs text-slate-500"><%= @post.created_at.strftime("%H:%M · %d %b %Y") %></div>
      </div>
    </div>

<div class="text-lg text-slate-800 mb-6 leading-relaxed break-words overflow-hidden">
  <%= @post.content %>
</div>

    <%# Панель действий %>
    <div class="border-t border-slate-100 pt-4 flex justify-between items-center">
      <div>
        <% if user_signed_in? %>
          <% liked = @post.likes.any? { |l| l.user_id == current_user.id } %>
          <% if liked %>
            <%= link_to post_like_path(@post, id: 0), data: { turbo_method: :delete }, class: "text-red-500 font-bold flex items-center gap-2" do %>
              ❤️ <%= @post.likes.count %>
            <% end %>
          <% else %>
            <%= link_to post_likes_path(@post), data: { turbo_method: :post }, class: "text-slate-400 hover:text-red-500 flex items-center gap-2" do %>
              🤍 <%= @post.likes.count %>
            <% end %>
          <% end %>
        <% else %>
          <span class="text-slate-400 flex items-center gap-2">🤍 <%= @post.likes.count %></span>
        <% end %>
      </div>

      <div class="flex gap-4 text-sm font-semibold">
        <% if @post.user == current_user %>
          <%= link_to "Редактировать", edit_post_path(@post), class: "text-blue-500 hover:underline" %>
        <% end %>
        <% if @post.user == current_user || (user_signed_in? && current_user.admin?) %>
          <%= link_to "Удалить", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "Точно удалить?" }, class: "text-red-500 hover:underline" %>
        <% end %>
      </div>
    </div>
  </article>

  <%# Блок комментариев %>
  <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100">
    <h3 class="font-bold text-slate-800 mb-4">Комментарии (<%= @post.comments.count %>)</h3>

    <% if user_signed_in? %>
      <%= form_with(model: [@post, @post.comments.build], local: true, class: "flex gap-2 mb-6") do |f| %>
        <%= f.text_field :body, placeholder: "Написать ответ...", class: "flex-grow px-4 py-2 border border-slate-200 rounded-full focus:ring-2 focus:ring-blue-500 outline-none" %>
        <%= f.submit "Ответить", class: "bg-blue-600 text-white px-5 py-2 rounded-full font-bold hover:bg-blue-700" %>
      <% end %>
    <% end %>
<div class="space-y-4">
      <% @post.comments.each do |comment| %>
        <% if comment.persisted? %>
          <div class="flex gap-3 bg-white p-4 rounded-xl border border-slate-100">
            <%# Аватарка %>
            <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center font-bold text-xs text-slate-500 overflow-hidden flex-shrink-0">
              <% if comment.user.avatar.attached? %>
                <%= image_tag comment.user.avatar, class: "w-full h-full object-cover" %>
              <% else %>
                <%= comment.user.username.first.upcase %>
              <% end %>
            </div>

            <%# Текст и метаданные комментария %>
            <div class="flex-grow min-w-0">
              <div class="flex justify-between items-center">
                <span class="font-bold text-sm truncate">@<%= comment.user.username %></span>
                
                <%# Кнопка удаления %>
                <% if user_signed_in? && (comment.user == current_user || @post.user == current_user || current_user.admin?) %>
                  <%= link_to "×", post_comment_path(@post, comment), data: { turbo_method: :delete }, class: "text-red-400 font-bold hover:text-red-600 pl-2" %>
                <% end %>
              </div>
              
              <p class="text-slate-700 text-sm mt-1 break-words"><%= comment.body %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>