<%# app/views/users/edit.html.erb %>

<div class="max-w-2xl mx-auto px-4 py-6 font-sans">
  
  <%# Шапка из Figma %>
  <div class="flex items-center gap-3 mb-6">
    <%= link_to user_path(@user), class: "p-2 rounded-xl text-slate-500 hover:bg-slate-100 transition-colors flex items-center justify-center" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <h2 class="text-xl font-bold text-slate-900">Редактировать профиль</h2>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
    <%# Декоративная обложка %>
    <div class="h-28 bg-gradient-to-r from-blue-500 to-blue-700 relative select-none"></div>

    <div class="px-6 pb-6">
      <%= form_with(model: @user, local: true, class: "space-y-5") do |form| %>
        
        <%# Блок отображения ошибок %>
        <% if @user.errors.any? %>
          <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm space-y-1 animate-fade-in">
            <h2 class="font-bold flex items-center gap-2">
              <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              Ошибки при сохранении:
            </h2>
            <ul class="list-disc pl-5 text-xs text-red-600/90 mt-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# Аватарка (Загрузка файла) %>
        <div class="relative w-fit -mt-10 mb-5 select-none group">
          <div class="w-20 h-20 bg-blue-600 rounded-full border-4 border-white shadow-md flex items-center justify-center text-white text-2xl font-bold overflow-hidden">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar, class: "w-full h-full object-cover rounded-full" %>
            <% else %>
              <%= @user.username.first(2).upcase %>
            <% end %>
          </div>
          <label for="user_avatar" class="absolute bottom-0 right-0 w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center text-white border-2 border-white hover:bg-blue-700 transition-colors shadow-md cursor-pointer" title="Загрузить аватарку">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
            </svg>
          </label>
        </div>

        <div>
          <%= form.label :avatar, "Аватарка профиля", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= form.file_field :avatar, accept: 'image/png,image/jpg,image/jpeg', class: "block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 transition-colors" %>
          <p class="text-slate-400 text-xs mt-1.5">PNG, JPG или JPEG. Максимум 5MB.</p>
        </div>

        <%# О себе (Bio) %>
        <div>
          <%= form.label :bio, "О себе", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <%= form.text_area :bio, rows: 4, placeholder: "Расскажите что-нибудь о себе...", maxlength: 160, class: "w-full px-4 py-2.5 border border-slate-200 rounded-xl bg-white outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors text-slate-900 placeholder-slate-400 resize-none text-sm" %>
        </div>

        <%# Кнопки действий %>
        <div class="flex gap-3 pt-2">
          <%= link_to "Отмена", user_path(@user), class: "flex-1 py-2.5 border border-slate-200 rounded-xl text-sm text-center text-slate-600 hover:bg-slate-50 transition-colors font-semibold" %>
          <%= form.submit "Сохранить изменения", class: "flex-1 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-semibold hover:bg-blue-700 transition-colors shadow-sm cursor-pointer" %>
        </div>

      <% end %>
    </div>
  </div>
</div>