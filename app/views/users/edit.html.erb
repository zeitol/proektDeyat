<div style="max-width: 500px; margin: 50px auto; padding: 20px; border: 1px solid #ccc; border-radius: 10px; background: #f9f9f9;">
  <h2 style="margin-bottom: 20px;">Редактировать профиль</h2>

  <%= form_with(model: @user, local: true) do |form| %>
    <% if @user.errors.any? %>
      <div style="color: red; margin-bottom: 15px;">
        <h2>Ошибки при сохранении:</h2>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 15px;">
        <%= form.label :avatar, "Аватарка профиля", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
        <%= form.file_field :avatar, accept: 'image/png,image/jpg,image/jpeg', style: "display: block; margin-top: 5px;" %>
    </div>

    <div style="margin-bottom: 15px;">
      <%# Исправлено на form.label и form.text_area %>
      <%= form.label :bio, "О себе", style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
      <%= form.text_area :bio, rows: 4, placeholder: "Расскажите что-нибудь о себе...", style: "width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #ccc; box-sizing: border-box;" %>
    </div>

    <div style="display: flex; gap: 10px;">
      <%# Исправлено на form.submit %>
      <%= form.submit "Сохранить изменения", style: "background: #1da1f2; color: white; padding: 10px 20px; border: none; border-radius: 20px; font-weight: bold; cursor: pointer;" %>
      <%= link_to "Отмена", user_path(@user), style: "background: #ccc; color: #333; padding: 10px 20px; border-radius: 20px; text-decoration: none; font-weight: bold;" %>
    </div>
  <% end %>
</div>