<div style="max-width: 700px; margin: 30px auto; padding: 0 15px;">
  <div style="border: 1px solid #ccc; padding: 20px; margin-bottom: 25px; border-radius: 10px; background: #f9f9f9;">
    
    <%# --- ЭТОТ БЛОК ОТВЕЧАЕТ ЗА ШАПКУ ПРОФИЛЯ (Аватарка + Имя + Кнопка) --- %>
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 15px; flex-wrap: wrap;">
      
      <%# Левая часть: Аватарка и текстовые данные %>
      <div style="display: flex; align-items: center; gap: 20px;">
        <% if @user.avatar.attached? %>
          <%# Если аватарка загружена — показываем её %>
          <%= image_tag @user.avatar, style: "width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 2px solid #ccc; flex-shrink: 0;" %>
        <% else %>
          <%# Если аватарки нет — показываем серую заглушку с первой буквой ника %>
          <div style="width: 100px; height: 100px; border-radius: 50%; background: #e1e8ed; display: flex; align-items: center; justify-content: center; font-size: 36px; font-weight: bold; color: #777; border: 2px solid #ccc; flex-shrink: 0;">
            <%= @user.username.first.upcase %>
          </div>
        <% end %>

        <div>
          <h1 style="margin: 0 0 5px 0;">@<%= @user.username %></h1>
          <p style="margin: 0; color: #666;"><%= @user.email %></p>
        </div>
      </div>

      <%# --- БЛОК МОДЕРАЦИИ ПРОФИЛЯ ДЛЯ АДМИНИСТРАТОРА --- %>
<% if user_signed_in? && current_user.admin? && current_user != @user %>
  <div style="margin-top: 15px; padding: 10px; border: 1px dashed #e57373; border-radius: 8px; background: #fdfcea; display: inline-block;">
    <span style="font-size: 0.85rem; color: #e57373; font-weight: bold; display: block; margin-bottom: 8px;">Модерация аккаунта:</span>
    
    <%= link_to "Удалить этот аккаунт навсегда", admin_user_path(@user), 
                data: { turbo_method: :delete, turbo_confirm: "Вы уверены, что хотите НАВСЕГДА удалить пользователя @#{@user.username} и все его данные (посты, комментарии, лайки)?" }, 
                style: "background: #e57373; color: white; padding: 8px 16px; border-radius: 20px; text-decoration: none; font-size: 0.9rem; font-weight: bold; display: inline-block; box-shadow: 0 2px 4px rgba(229,115,115,0.3);" %>
  </div>
<% end %>

<%# Правая часть: Кнопка редактирования ИЛИ Подписки %>
      <div>
        <% if @user == current_user %>
          <%= link_to "Редактировать профиль", edit_user_path(@user), style: "background: #1da1f2; color: white; padding: 8px 16px; border-radius: 20px; text-decoration: none; font-weight: bold;" %>
        <% elsif user_signed_in? %>
          <% if current_user.following?(@user) %>
            <%= link_to "Отписаться", unfollow_user_path(@user), data: { turbo_method: :delete }, style: "background: #e57373; color: white; padding: 8px 16px; border-radius: 20px; text-decoration: none; font-weight: bold;" %>
          <% else %>
            <%= link_to "Подписаться", follow_user_path(@user), data: { turbo_method: :post }, style: "background: #1da1f2; color: white; padding: 8px 16px; border-radius: 20px; text-decoration: none; font-weight: bold;" %>
          <% end %>
        <% end %>
      </div>
    </div> <%# Контурный тег закрывает flex-блок шапки (исправлено!) %>

    <%# --- БЛОК О СЕБЕ --- %>
    <div style="margin-top: 25px; border-top: 1px solid #eee; padding-top: 15px;">
      <h2 style="margin: 0 0 10px 0; font-size: 1.2rem; color: #333;">О себе</h2>
      <p style="margin: 0; line-height: 1.5; color: #444;">
        <%= @user.bio.present? ? @user.bio : "Пользователь пока не добавил описание." %>
      </p>
    </div>

  </div> <%# Закрывает серую карточку профиля %>

<%# --- ЛЕНТА ПОСТОВ ПОЛЬЗОВАТЕЛЯ --- %>
  <div>
    <h2 style="margin-bottom: 15px;">Посты пользователя</h2>

    <% if @posts.any? %>
      <%= render @posts %>

      <%# --- БЛОК ПАГИНАЦИИ В ПРОФИЛЕ --- %>
      <div style="margin-top: 30px; margin-bottom: 30px; display: flex; justify-content: center; font-family: sans-serif;">
        <div class="pagination-container" style="display: flex; gap: 8px; align-items: center;">
          <%= paginate @posts, window: 2 %>
        </div>
      </div>
      
      <%# Стили для кнопок (если они еще не добавлены в общий CSS) %>
      <style>
        .pagination-container a, .pagination-container .current {
          padding: 8px 14px;
          border: 1px solid #ccc;
          border-radius: 20px;
          text-decoration: none;
          color: #1da1f2;
          font-weight: bold;
          font-size: 0.9rem;
        }
        .pagination-container .current {
          background: #1da1f2;
          color: white;
          border-color: #1da1f2;
        }
        .pagination-container .disabled, .pagination-container .gap {
          padding: 8px 14px;
          color: #999;
          font-size: 0.9rem;
        }
      </style>
      <%# -------------------------------- %>

    <% else %>
      <div style="text-align: center; padding: 30px 0; color: #666;">
        <p>У пользователя пока нет постов</p>
      </div>
    <% end %>
  </div>
</div>