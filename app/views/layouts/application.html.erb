<!DOCTYPE html>
<html>
  <head>
    <title>Наш проект</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin: 0; font-family: Arial, sans-serif; background: #f5f5f5;">
    <div style="display: flex; min-height: 100vh;">

      <div style="width: 220px; background: white; border-right: 1px solid #ddd; padding: 20px; box-sizing: border-box;">
        <div style="font-size: 32px; font-weight: bold; margin-bottom: 30px; text-align: center;">
          Y
        </div>

        <nav style="display: flex; flex-direction: column; gap: 10px;">
          <%= link_to "Главная", root_path, style: "text-decoration: none; color: black; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fafafa;" %>

          <% if user_signed_in? %>
            <%= link_to "Профиль", user_path(current_user), style: "text-decoration: none; color: black; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fafafa;" %>

            <%= button_to "Выйти",
              destroy_user_session_path,
              method: :delete,
              form: { style: "margin: 0; width: 100%;" },
              style: "width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fafafa; cursor: pointer; text-align: left; font-family: Arial, sans-serif; font-size: 16px; color: black;" %>
          <% else %>
            <%= link_to "Войти", new_user_session_path, style: "text-decoration: none; color: black; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fafafa;" %>

            <%= link_to "Регистрация", new_user_registration_path, style: "text-decoration: none; color: black; padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: #fafafa;" %>
          <% end %>
        </nav>
      </div>

      <div style="flex: 1; padding: 30px;">
        <div style="background: white; border: 1px solid #ddd; border-radius: 10px; padding: 20px; min-height: calc(100vh - 60px);">
          <%= yield %>
        </div>
      </div>

    </div>
  </body>
</html>