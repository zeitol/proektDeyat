<div style="max-width: 800px; margin: 30px auto; padding: 0 15px; font-family: sans-serif;">
  <h1 style="margin-bottom: 20px; color: #333;">Панель администратора: Пользователи</h1>

  <table style="width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #ccc; border-radius: 8px; overflow: hidden;">
    <thead>
      <tr style="background: #f4f4f4; text-align: left; border-bottom: 2px solid #ccc;">
        <th style="padding: 12px;">ID</th>
        <th style="padding: 12px;">Имя пользователя</th>
        <th style="padding: 12px;">Email</th>
        <th style="padding: 12px;">Дата регистрации</th>
        <th style="padding: 12px; text-align: right;">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 12px;"><%= user.id %></td>
          <td style="padding: 12px;">
            <%= link_to "@#{user.username}", user_path(user), style: "color: #1da1f2; text-decoration: none; font-weight: bold;" %>
          </td>
          <td style="padding: 12px; color: #666;"><%= user.email %></td>
          <td style="padding: 12px; font-size: 0.85rem;"><%= user.created_at.strftime("%d.%m.%Y %H:%M") %></td>
          <td style="padding: 12px; text-align: right;">
            <%# Кнопка отправляет DELETE-запрос в Admin::UsersController#destroy %>
            <%= link_to "Удалить аккаунт", admin_user_path(user), 
                        data: { turbo_method: :delete, turbo_confirm: "Вы уверены, что хотите НАВСЕГДА удалить пользователя @#{user.username} и все его данные?" }, 
                        style: "background: #e57373; color: white; padding: 6px 12px; border-radius: 4px; text-decoration: none; font-size: 0.85rem; font-weight: bold;" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div style="margin-top: 20px;">
    <%= link_to "← На главную", root_path, style: "color: #555; text-decoration: none;" %>
  </div>
</div>