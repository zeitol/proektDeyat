<%# app/views/devise/sessions/new.html.erb %>

<div class="min-h-screen bg-slate-50 flex font-sans">
  
  <%# --- ЛЕВАЯ ДЕКОРАТИВНАЯ ПАНЕЛЬ (Показывается только на экранах от lg:) --- %>
  <div class="hidden lg:flex w-1/2 bg-slate-900 flex-col justify-between p-12 select-none">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-md">
        <span class="text-white font-bold text-lg">Rb</span>
      </div>
      <span class="text-white font-bold text-xl tracking-wide">Ribbon</span>
    </div>
    
<div class="space-y-4">
  <% if @recent_posts.any? %>
    <% @recent_posts.each do |post| %>
      <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-sm">
        <%# Добавили break-words, чтобы текст переносился и не ломал верстку %>
        <p class="text-slate-700 italic break-words">
          "<%= post.content.to_s.truncate(100) %>"
        </p>
        
        <div class="flex items-center gap-2 mt-3">
          <%# Блок аватарки с проверкой attached? %>
          <div class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center text-[10px] font-bold text-slate-500 overflow-hidden flex-shrink-0">
            <% if post.user.avatar.attached? %>
              <%= image_tag post.user.avatar, class: "w-full h-full object-cover" %>
            <% else %>
              <%= post.user.username.first.upcase %>
            <% end %>
          </div>
          
          <span class="text-xs font-semibold text-slate-600 truncate">
            @<%= post.user.username %>
          </span>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="text-slate-400 text-sm italic">Пока постов нет, станьте первым!</p>
  <% end %>
</div>
    
    <p class="text-slate-500 text-sm">© 2026 Ribbon. Student project.</p>
  </div>

  <%# --- ПРАВАЯ ПАНЕЛЬ С ФОРМОЙ ВХОДА --- %>
  <div class="flex-1 flex items-center justify-center p-8">
    <div class="w-full max-w-md">
      
      <%# Мобильный логотип (скрывается на больших экранах lg:) %>
      <div class="flex items-center gap-2 mb-8 lg:hidden">
        <div class="w-9 h-9 bg-blue-600 rounded-xl flex items-center justify-center shadow-sm">
          <span class="text-white text-sm font-bold">Rb</span>
        </div>
        <span class="font-bold text-slate-900 text-xl tracking-wide">Ribbon</span>
      </div>

      <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-900 mb-1">Welcome back</h1>
        <p class="text-slate-500 text-sm">Sign in to your Ribbon account.</p>
      </div>

      <%# --- ВЫВОД ОШИБОК ДЕВАЙЗА --- %>
      <% if flash[:alert] %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl flex items-center gap-2 text-red-700 text-sm animate-fade-in">
          <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%# --- ФОРМА ВХОДА ДЛЯ REILS --- %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        
        <%# Email Поле %>
        <div>
          <%= f.label :email, "Email address", class: "block text-sm font-medium text-slate-700 mb-1.5" %>
          <div class="relative">
            <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <%= f.email_field :email, 
                              autofocus: true, 
                              autocomplete: "email", 
                              placeholder: "you@example.com",
                              class: "w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-xl bg-white outline-none transition-colors text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 text-sm" %>
          </div>
        </div>

        <%# Password Поле %>
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, "Password", class: "text-sm font-medium text-slate-700" %>
<% if devise_mapping.recoverable? %>
  <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm text-blue-600 hover:text-blue-700 font-medium" %>
<% end %>
          </div>
          <div class="relative">
            <div class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
            <%= f.password_field :password, 
                                 autocomplete: "current-password", 
                                 placeholder: "Enter your password",
                                 class: "w-full pl-10 pr-4 py-2.5 border border-slate-200 rounded-xl bg-white outline-none transition-colors text-slate-900 placeholder-slate-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 text-sm" %>
          </div>
        </div>

        <%# Чекбокс "Remember me" из Devise (аккуратно интегрированный) %>
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2 py-1 select-none">
            <%= f.check_box :remember_me, class: "w-4 h-4 text-blue-600 border-slate-200 rounded focus:ring-blue-500 cursor-pointer" %>
            <%= f.label :remember_me, "Remember me on this device", class: "text-xs text-slate-600 font-medium cursor-pointer" %>
          </div>
        <% end %>

        <%# Кнопка отправки %>
        <%= f.submit "Sign In", class: "w-full py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700 transition-colors shadow-sm cursor-pointer text-sm" %>
      <% end %>

      <%# Ссылка на регистрацию %>
      <p class="text-center text-sm text-slate-500 mt-6">
        Don't have an account?{" "}
        <%= link_to "Create one", new_registration_path(resource_name), class: "text-blue-600 hover:text-blue-700 font-semibold" %>
      </p>

    </div>
  </div>
</div>